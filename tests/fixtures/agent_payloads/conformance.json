{
  "description": "Conformance fixtures (WP-140): pairs of native agent payloads that MUST normalize to the same HookInput. When an agent changes its payload shape, update its translator until these pass again.",
  "cases": [
    {
      "name": "pre_edit",
      "expect": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "file_path": "/repo/src/app.py",
        "cwd": "/repo",
        "session_id": "s-1"
      },
      "claude_code": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {"file_path": "/repo/src/app.py", "old_string": "a", "new_string": "b"},
        "cwd": "/repo",
        "session_id": "s-1"
      },
      "opencode": {
        "type": "tool.execute.before",
        "tool": "edit",
        "args": {"filePath": "/repo/src/app.py", "oldString": "a", "newString": "b"},
        "directory": "/repo",
        "sessionID": "s-1"
      },
      "codex": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {"file_path": "/repo/src/app.py", "old_string": "a", "new_string": "b"},
        "cwd": "/repo",
        "session_id": "s-1",
        "turn_id": "t-1",
        "transcript_path": "/tmp/t.jsonl",
        "model": "gpt-5",
        "permission_mode": "default",
        "tool_use_id": "tu-1"
      },
      "gemini": {
        "hook_event_name": "BeforeTool",
        "tool_name": "replace",
        "tool_input": {"file_path": "/repo/src/app.py", "old_string": "a", "new_string": "b"},
        "cwd": "/repo",
        "session_id": "s-1",
        "transcript_path": "/tmp/t.json",
        "timestamp": "2026-02-14T00:00:00Z"
      }
    },
    {
      "name": "post_write",
      "expect": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "file_path": "/repo/new.py",
        "cwd": "/repo",
        "session_id": "s-2"
      },
      "claude_code": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "tool_input": {"file_path": "/repo/new.py", "content": "x = 1\n"},
        "cwd": "/repo",
        "session_id": "s-2"
      },
      "opencode": {
        "type": "tool.execute.after",
        "tool": "write",
        "args": {"filePath": "/repo/new.py", "content": "x = 1\n"},
        "directory": "/repo",
        "sessionID": "s-2"
      },
      "codex": {
        "hook_event_name": "PostToolUse",
        "tool_name": "Write",
        "tool_input": {"file_path": "/repo/new.py", "content": "x = 1\n"},
        "cwd": "/repo",
        "session_id": "s-2",
        "turn_id": "t-2",
        "tool_use_id": "tu-2"
      },
      "gemini": {
        "hook_event_name": "AfterTool",
        "tool_name": "write_file",
        "tool_input": {"file_path": "/repo/new.py", "content": "x = 1\n"},
        "tool_response": {"success": true},
        "cwd": "/repo",
        "session_id": "s-2",
        "timestamp": "2026-02-14T00:00:00Z"
      }
    },
    {
